# These are shell environment settings. This file is NOT loaded automatically.
# Export the settings you need before starting ./run.sh.
OPENJEV_BACKEND=nli
OPENJEV_DEVICE=cpu
OPENJEV_CACHE_DIR=.models
OPENJEV_OFFLINE=0
# Optional: require this bearer token for /v1 endpoints.
# OPENJEV_API_KEY=replace-with-your-local-key
# Optional: connect an already-running local Kev server instead of MiniLM.
# OPENJEV_BACKEND=kev
# OPENJEV_KEV_URL=http://127.0.0.1:8009

# DiffusionGemma 26B-A4B NVFP4, through loopback HTTP or an SSH tunnel.
# OPENJEV_BACKEND=diffusiongemma
# OPENJEV_DIFFUSION_URL=http://127.0.0.1:8008
# OPENJEV_DIFFUSION_MAX_TOKENS=8192
# Optional persistent authenticated stdio transport; normally use an SSH tunnel.
# OPENJEV_RELAY_COMMAND='["ssh", "gpu-host"]'
# OPENJEV_RELAY_IDENTITY_FILE=/absolute/path/to/openjev/.data/openjev/status.json
